<?xml version="1.0" encoding="UTF-8"?>
<sBTemPsy:PropertiesBlock
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:sBTemPsy="http://www.svv.lu/offline/SBTemPsy">
  <properties
      xsi:type="sBTemPsy:AndProperty">
    <property1
        xsi:type="sBTemPsy:AndProperty">
      <property1
          xsi:type="sBTemPsy:AndProperty">
        <property1
            xsi:type="sBTemPsy:Property">
          <scope
              xsi:type="sBTemPsy:Globally"/>
          <pattern
              xsi:type="sBTemPsy:EventAssertion">
            <condition
                xsi:type="sBTemPsy:Assertion">
              <signal
                  id="y2y1"/>
              <dAPred
                  rOp="&gt;">
        	    <value
                    val="7.5"/>
              </dAPred>
            </condition>
          </pattern>
        </property1>
        <property2
            xsi:type="sBTemPsy:Property">
          <scope
              xsi:type="sBTemPsy:Globally"/>
          <pattern
              xsi:type="sBTemPsy:EventAssertion">
            <condition
                xsi:type="sBTemPsy:Assertion">
              <signal
                  id="y3y2"/>
                <dAPred
                    rOp="&gt;">
        	      <value
                      val="7.5"/>
                </dAPred>
            </condition>
          </pattern>
        </property2>
      </property1>
      <property2
          xsi:type="sBTemPsy:Property">
        <scope
            xsi:type="sBTemPsy:Globally"/>
        <pattern
            xsi:type="sBTemPsy:EventAssertion">
          <condition
              xsi:type="sBTemPsy:Assertion">
            <signal
                id="y4y3"/>
            <dAPred
                rOp="&gt;">
        	  <value
                  val="7.5"/>
            </dAPred>
          </condition>
        </pattern>
      </property2>
    </property1>
    <property2
        xsi:type="sBTemPsy:Property">
      <scope
          xsi:type="sBTemPsy:Globally"/>
      <pattern
          xsi:type="sBTemPsy:EventAssertion">
        <condition
            xsi:type="sBTemPsy:Assertion">
          <signal
              id="y5y4"/>
          <dAPred
              rOp="&gt;">
        	<value
                val="7.5"/>
          </dAPred>
        </condition>
      </pattern>
    </property2>
  </properties>
</sBTemPsy:PropertiesBlock>
