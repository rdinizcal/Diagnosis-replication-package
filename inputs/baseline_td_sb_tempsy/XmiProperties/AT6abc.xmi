<?xml version="1.0" encoding="UTF-8"?>
<sBTemPsy:PropertiesBlock
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:sBTemPsy="http://www.svv.lu/offline/SBTemPsy"
    xsi:schemaLocation="http://www.svv.lu/offline/SBTemPsy ../models/sbtempsy.ecore">
  <properties
      xsi:type="sBTemPsy:OrProperty">
    <property1
        xsi:type="sBTemPsy:NotProperty"> 
      <property
          xsi:type="sBTemPsy:Property">
        <scope
            xsi:type="sBTemPsy:Before">
          <boundary>
            <absoluteB
                val="30.0"/>
          </boundary>
        </scope>
        <pattern
            xsi:type="sBTemPsy:EventAssertion">
          <condition
              xsi:type="sBTemPsy:Assertion">
            <signal
                id="Engine"/>
              <dAPred
                  rOp="&lt;">
                <value
                    val="3000.0"/>
              </dAPred>
          </condition>
        </pattern>
      </property>
    </property1>
    <property2
        xsi:type="sBTemPsy:AndProperty">
      <property1
          xsi:type="sBTemPsy:Property">
        <scope
            xsi:type="sBTemPsy:Before">
          <boundary>
            <absoluteB
                val="30.0"/>
          </boundary>
        </scope>
        <pattern
            xsi:type="sBTemPsy:EventAssertion">
          <condition
              xsi:type="sBTemPsy:Assertion">
            <signal
                id="Engine"/>
            <dAPred
                rOp="&lt;">
              <value
                val="3000.0"/>
            </dAPred> 
          </condition>
        </pattern>
      </property1>
      <property2
          xsi:type="sBTemPsy:AndProperty">
        <property1
            xsi:type="sBTemPsy:Property">
          <scope
              xsi:type="sBTemPsy:Before">
            <boundary>
              <absoluteB
                  val="4.0"/>
            </boundary>
          </scope>
          <pattern
              xsi:type="sBTemPsy:EventAssertion">
            <condition
                xsi:type="sBTemPsy:Assertion">
              <signal
                  id="Speed"/>
                <dAPred
                    rOp="&lt;">
                  <value
                      val="35.0"/>
                </dAPred>
            </condition>
          </pattern>
        </property1>
        <property2
            xsi:type="sBTemPsy:AndProperty">
          <property1
              xsi:type="sBTemPsy:Property">
            <scope
                xsi:type="sBTemPsy:Before">
              <boundary>
                <absoluteB
                    val="8.0"/>
              </boundary>
            </scope>
            <pattern
                xsi:type="sBTemPsy:EventAssertion">
              <condition
                  xsi:type="sBTemPsy:Assertion">
                <signal
                    id="Speed"/>
                  <dAPred
                      rOp="&lt;">
                    <value
                        val="50.0"/>
                  </dAPred>
              </condition>
            </pattern>
          </property1>
          <property2
              xsi:type="sBTemPsy:Property">
            <scope
                xsi:type="sBTemPsy:Before">
              <boundary>
                <absoluteB
                    val="20.0"/>
              </boundary>
            </scope>
            <pattern
                xsi:type="sBTemPsy:EventAssertion">
              <condition
                  xsi:type="sBTemPsy:Assertion">
                <signal
                    id="Speed"/>
                  <dAPred
                      rOp="&lt;">
                    <value
                        val="65.0"/>
                  </dAPred>
              </condition>
            </pattern>
          </property2>
        </property2>
      </property2>
    </property2>
  </properties>
</sBTemPsy:PropertiesBlock>
