<?xml version="1.0" encoding="UTF-8"?>
<sBTemPsy:PropertiesBlock
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:sBTemPsy="http://www.svv.lu/offline/SBTemPsy">
  <properties
      xsi:type="sBTemPsy:Property">
    <scope xsi:type="sBTemPsy:Globally"/>
    <pattern
        xsi:type="sBTemPsy:EventAssertion">
      <condition
          xsi:type="sBTemPsy:Assertion">
        <signal
            id="Engine"/>
        <dAPred
           rOp="&lt;">
        	<value
            	val="4750"/>
        </dAPred> 
      </condition>
    </pattern>
  </properties>
</sBTemPsy:PropertiesBlock>
