digraph ExpertTree {
rankdir=TB;
node [shape=box,fontname=Helvetica];
root [label="exp14 expert satisfied region"];
rule [label="rpm <= running_max(engine_speed,[0,t0]) OR speed > running_max(vehicle_speed,[0,t1])"];
root -> rule;
rule -> sat [label="true"];
rule -> unsat [label="false"];
sat [label="SATISFIED",shape=ellipse];
unsat [label="VIOLATED",shape=ellipse];
}
