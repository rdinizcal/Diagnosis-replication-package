digraph ExpertTree {
rankdir=TB;
node [shape=box,fontname=Helvetica];
root [label="exp24 expert satisfied region"];
or [label="OR"];
root -> or;
b0 [label="t0: (3.25, 20.0]\nt1: (0.0, 10.0]\ndistance: (12.0, 15.1]"];
or -> b0;
b0 -> sat0;
sat0 [label="SATISFIED",shape=ellipse];
root -> unsat [label="otherwise"];
unsat [label="VIOLATED",shape=ellipse];
}
