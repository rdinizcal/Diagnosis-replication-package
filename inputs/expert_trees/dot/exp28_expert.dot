digraph ExpertTree {
rankdir=TB;
node [shape=box,fontname=Helvetica];
root [label="exp28 expert satisfied region"];
or [label="OR"];
root -> or;
b0 [label="quantifier0: (0.0, 1.0]\nquantifier1: (0.0, 1.0]\ndistance: (6.0, 7.91]"];
or -> b0;
b0 -> sat0;
sat0 [label="SATISFIED",shape=ellipse];
b1 [label="quantifier0: (0.0, 1.0]\nquantifier1: (1.0, 2.0]\ndistance: (6.0, 10.0]"];
