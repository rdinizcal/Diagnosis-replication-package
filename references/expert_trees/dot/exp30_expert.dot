b0 [label="relation0: (0.0, 1.0]\ndistance0: (7.0, 10.0]\nrelation1: (0.0, 2.0]\ndistance1: (7.0, 7.58]"];
or -> b0;
b0 -> sat0;
sat0 [label="SATISFIED",shape=ellipse];
b1 [label="relation0: (1.0, 2.0]\ndistance0: (7.0, 10.0]\nrelation1: (1.0, 2.0]\ndistance1: (7.0, 7.58]"];
or -> b1;
b1 -> sat1;
