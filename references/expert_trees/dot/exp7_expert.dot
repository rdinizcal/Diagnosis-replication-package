digraph ExpertTree {
rankdir=TB;
node [shape=box,fontname=Helvetica];
root [label="exp7 expert satisfied region"];
or [label="OR"];
root -> or;
b0 [label="t0: (0.0, 0.0]\nt1: (30.0, 30.0]\ndelay: (0.0, 1.2]"];
or -> b0;
b0 -> sat0;
sat0 [label="SATISFIED",shape=ellipse];
root -> unsat [label="otherwise"];
unsat [label="VIOLATED",shape=ellipse];
}
