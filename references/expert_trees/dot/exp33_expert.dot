digraph ExpertTree {
rankdir=TB;
node [shape=box,fontname=Helvetica];
root [label="exp33 expert satisfied region"];
rule [label="forall t: logical(d2obs(t) > 50, desired_x(t)-current_x(t) < distance)"];
root -> rule;
rule -> sat [label="true"];
rule -> unsat [label="false"];
sat [label="SATISFIED",shape=ellipse];
unsat [label="VIOLATED",shape=ellipse];
}
