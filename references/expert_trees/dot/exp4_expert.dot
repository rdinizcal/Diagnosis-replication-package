digraph ExpertTree {
rankdir=TB;
node [shape=box,fontname=Helvetica];
root [label="exp4 expert satisfied region"];
or [label="OR"];
root -> or;
b0 [label="t0: (0.0, 5.0]\nt1: (5.0, 7.1]\nrpm: (4700.0, 4800.0]"];
or -> b0;
b0 -> sat0;
sat0 [label="SATISFIED",shape=ellipse];
b1 [label="t0: (0.0, 5.0]\nt1: (7.1, 15.0]\nrpm: (4754.4, 4800.0]"];
or -> b1;
b1 -> sat1;
sat1 [label="SATISFIED",shape=ellipse];
root -> unsat [label="otherwise"];
unsat [label="VIOLATED",shape=ellipse];
}
