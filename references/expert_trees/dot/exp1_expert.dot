digraph ExpertTree {
rankdir=TB;
node [shape=box,fontname=Helvetica];
root [label="exp1 expert satisfied region"];
or [label="OR"];
root -> or;
b0 [label="t0: (0.0, 0.0]\nt1: (20.0, 20.0]\nspeed: (120.02262, 140.0]"];
or -> b0;
b0 -> sat0;
sat0 [label="SATISFIED",shape=ellipse];
root -> unsat [label="otherwise"];
unsat [label="VIOLATED",shape=ellipse];
}
