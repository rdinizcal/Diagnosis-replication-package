# Release metadata is written after the image is built. Excluding it prevents
# the image digest from depending on a file whose purpose is to record that
# same digest.
environment/versions.json

# Derived artifacts are regenerated by the image entry points.
analysis/
raw_results/rerun/

# Local runtime debris must never affect the image identity.
**/__pycache__/
**/*.pyc
**/.pytest_cache/
.venv/

# The complete upstream repository is provenance-only. The image installs the
# archive-safe executable subset from tool/.
Diagnosis/
.git/
ci-derived/
tool_trees_at_run/
raw_results/archive_downloads/
